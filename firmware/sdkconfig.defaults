# Плата: ESP32-S3 N16R8 (16 МБ flash quad, 8 МБ PSRAM octal)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM. Если не найдётся, прошивка всё равно загрузится и скажет об этом в логе
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Код с запасом по скорости (рисование кадров), а не по размеру
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Лог идёт в оба USB-порта платы: и в UART (COM), и в родной USB. Команды принимаются с обоих (console.cc)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Wi-Fi и время: четыре сервера SNTP (Китай-первые, потом общий), событийная задача с запасом стека под печать
CONFIG_LWIP_SNTP_MAX_SERVERS=4
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Внутренней памяти мало (звук, экран, Wi-Fi делят около 200 КБ), поэтому всё, что можно, у Wi-Fi и lwIP
# кладём в PSRAM и держим меньше буферов (для голосового клиента ~30 КБ/с хватает с запасом)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# Горячие функции Wi-Fi не держим в IRAM: это ~20 КБ внутренней памяти, скорость Wi-Fi нам не нужна
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# LVGL 9 (экран). Должно совпадать с firmware/test_host/lv_conf.h, тогда картинки на компьютере и на плате одинаковы.
CONFIG_LV_COLOR_DEPTH_16=y
# Выравнивание буферов под линейку кэша: нужно, если буфер кадра придётся положить в PSRAM
CONFIG_LV_DRAW_BUF_ALIGN=64
# Память LVGL из общей кучи (а не отдельный статический кусок 64 КБ)
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y
# Кадры не чаще каждых 30 мс (около 33 в секунду)
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# ---------------------------------------------------------------------------------------------------------------------
# Слово «Джарвис» на самой плате: ESP-SR 2.6.1 (main/idf_component.yml), движок AFE + WakeNet9 + VADNet (main/wake.cc)
# ---------------------------------------------------------------------------------------------------------------------
# Модели лежат в разделе model (partitions.csv, 0x820000, 4 МБ), образ srmodels.bin собирается и прошивается сам
CONFIG_MODEL_IN_FLASH=y
# Единственное слово: WakeNet9 wn9_jarvis_tts («Jarvis», обучена на синтезированной речи). Других моделей слов нет
CONFIG_SR_WN_WN9_JARVIS_TTS=y
# Распознавание команд (MultiNet) не нужно: команды понимает сервер на ноутбуке
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
# Конец фразы: нейросетевой VAD vadnet1_medium (292 КБ во flash). WebRTC VAD хуже отличает речь от шума комнаты,
# а лишние ~5% процессора ради надёжного «человек договорил» стоят того
CONFIG_SR_VADN_VADNET1_MEDIUM=y
# Шумоподавление не используем (нужно только слово и конец фразы, а звук на сервер идёт с микрофона напрямую).
# Модель nsnet в образ не кладём: остаётся WebRTC-вариант, у него нет файлов моделей
CONFIG_SR_NSN_WEBRTC=y
# Требования ESP-SR для ESP32-S3 (esp_process_sdkconfig.c, при несовпадении движок пишет предупреждения в лог):
#   - процессор 240 МГц (выше уже стоит), flash >= 80 МГц, PSRAM >= 80 МГц (выше уже стоят);
#   - линейка кэша данных 64 байта (бесплатно, помогает при чтении модели из PSRAM);
#   - кэш данных 64 КБ ESP-SR только РЕКОМЕНДУЕТ. Он отнимает 32 КБ внутренней памяти, а её и так мало (Wi-Fi, экран,
#     звук), поэтому оставлен 32 КБ по умолчанию; при старте движок напишет «Data cache recommends 64KB», это нормально.
#     Если на плате не хватит процессора (в логе WAKE stat видно потерю кадров), включить CONFIG_ESP32S3_DATA_CACHE_64KB=y.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Загрузка процессора по задачам (счётчики времени FreeRTOS, uxTaskGetSystemState): строки «WAKE perf» и «WAKE stat» показывают,
# сколько ядра съедают wake_fetch, LVGL, Wi-Fi и остальные (wake_perf.h). Цена: около 0,8 КБ кода в переключении задач
# (внутренняя память) и по 12 байт на каждую задачу, то есть порядка 1 КБ; буферы измерений (около 4 КБ) лежат в PSRAM.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
